# ── API Backend ───────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001/api/v1

# ── Interruptor de modo ───────────────────────────────
# proto → sin login real, usuario demo, datos mock en memoria
# azure → Azure AD / EntraID via MSAL, llama al backend real
VITE_AUTH_MODE=proto
VITE_USE_MOCK=true

# ── Mostrar interruptor en UI (dev only) ───────────────
VITE_SHOW_MODE_SWITCHER=true

# ── Azure AD (requerido solo cuando AUTH_MODE=azure) ──
VITE_AZURE_TENANT_ID=tu-tenant-id
VITE_AZURE_CLIENT_ID=tu-client-id-frontend
VITE_AZURE_REDIRECT_URI=http://localhost:5173
